# Copy to .env and fill in once AdSense approves the site.
# Leave empty to show the labelled ad placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=

# One AdSense ad unit per placement (IDs match the design's "Ad slots" board):
# ad-home-1
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# ad-list-1 (/recipes and category pages)
NEXT_PUBLIC_ADSENSE_SLOT_LIST=
# ad-article-1 (after intro)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_1=
# ad-article-2 (desktop sidebar)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_2=
# ad-article-3 (near end)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_3=
# ad-mobile-1 (phones: replaces the homepage and article slots)
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=

# Your production domain, for canonical URLs, JSON-LD and the sitemap.
# SITE_URL=https://www.yourdomain.com
